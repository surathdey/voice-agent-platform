# Copy to .env — docker compose reads it. Everything has a working default;
# the platform boots and is fully testable WITHOUT any provider keys.

# Database (used by docker compose for the db service + backend DSN)
POSTGRES_USER=vap
POSTGRES_PASSWORD=vap-demo-password
POSTGRES_DB=voice_platform

# App secret for JWT signing — change in any real deployment
SECRET_KEY=dev-only-change-me

# Telephony mode: stub (no calls, everything else testable) | managed | self_hosted
TELEPHONY_MODE=stub

# Provider keys — PLACEHOLDERS. Leave empty for stub-mode testing.
VAPI_API_KEY=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
SARVAM_API_KEY=

# First-boot seed (demo tenant + login)
SEED_TENANT_NAME=QGBS
SEED_USER_EMAIL=demo@qgbs.example
SEED_USER_PASSWORD=demo-password
