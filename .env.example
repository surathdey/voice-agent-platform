# Copy to .env — docker compose reads it. Everything has a working default;
# the platform boots and is fully testable WITHOUT any provider keys.

# Database (used by docker compose for the db service + backend DSN)
POSTGRES_USER=vap
POSTGRES_PASSWORD=vap-demo-password
POSTGRES_DB=voice_platform

# App secret for JWT signing — change in any real deployment
SECRET_KEY=dev-only-change-me

# Telephony mode: stub (no calls, everything else testable) | managed | self_hosted
TELEPHONY_MODE=stub

# Provider keys — PLACEHOLDERS. Leave empty for stub-mode testing.
# These are the platform-level fallback; each tenant can override them in
# the console under Settings → Providers (tenant values win, secrets there
# are stored server-side and only ever shown masked).
VAPI_API_KEY=
VAPI_DEFAULT_MODEL=
VAPI_DEFAULT_VOICE=
VAPI_PHONE_NUMBER_ID=
# Vapi voice profiles (per language: provider / TTS model / female / male
# voice IDs). These are the .env overrides of the shipped defaults
# (English: 11labs eleven_turbo_v2_5; Hindi + Bengali: 11labs eleven_v3 —
# with the owner's verified RPI voice IDs). Per-tenant values under
# Settings → Providers win over these. Voice IDs are identifiers, not
# secrets — safe to keep in plain text.
VAPI_EN_VOICE_PROVIDER=
VAPI_EN_TTS_MODEL=
VAPI_EN_VOICE_ID_FEMALE=
VAPI_EN_VOICE_ID_MALE=
VAPI_HI_VOICE_PROVIDER=
VAPI_HI_TTS_MODEL=
VAPI_HI_VOICE_ID_FEMALE=
VAPI_HI_VOICE_ID_MALE=
VAPI_BN_VOICE_PROVIDER=
VAPI_BN_TTS_MODEL=
VAPI_BN_VOICE_ID_FEMALE=
VAPI_BN_VOICE_ID_MALE=
# Vapi transcriber profiles (per language: STT provider / model — Deepgram
# via Vapi). Shipped defaults: English + Hindi deepgram/nova-2; Bengali
# deepgram/nova-3 (Vapi's nova-2 language enum has no Bengali — a bn call
# on nova-2 is rejected HTTP 400). Per-tenant values under
# Settings → Providers win over these.
VAPI_EN_TRANSCRIBER_PROVIDER=
VAPI_EN_TRANSCRIBER_MODEL=
VAPI_HI_TRANSCRIBER_PROVIDER=
VAPI_HI_TRANSCRIBER_MODEL=
VAPI_BN_TRANSCRIBER_PROVIDER=
VAPI_BN_TRANSCRIBER_MODEL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
SARVAM_API_KEY=

# Rate cards (A12) — OPTIONAL platform-level fallbacks for the per-minute
# rates used to compute per-call cost breakdowns at finalize. Per-tenant
# values under Settings → Providers → Rate card win over these. Rates are
# the tenant's contracted prices — they ship EMPTY (an unset rate honestly
# costs 0; nothing here is a price list). Vapi's rate is only an estimate
# fallback for reports that carry no cost breakdown of their own.
VAPI_RATE_TELEPHONY_PER_MIN=
PLIVO_RATE_TELEPHONY_PER_MIN=
SARVAM_RATE_STT_PER_MIN=
SARVAM_RATE_LLM_PER_MIN=
SARVAM_RATE_TTS_PER_MIN=

# Provider API base URLs (A6) — production defaults; override only for
# staging/tests (the smoke suite points these at a local fake provider).
VAPI_BASE_URL=https://api.vapi.ai
PLIVO_BASE_URL=https://api.plivo.com

# Sarvam Saaras STT streaming base (A7) — the WebSocket endpoint the
# self-hosted STT leg opens per call. Override only for staging/tests
# (the smoke suite points it at a local mock Saaras server).
SARVAM_WS_URL=wss://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v2.5

# Sarvam HTTP API base (A8) — the LLM leg (chat completions) and the
# Bulbul TTS leg call {base}/chat/completions and {base}/text-to-speech
# with the same SARVAM_API_KEY. Override only for staging/tests (the
# smoke suite points it at a local mock Sarvam server).
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TTS_MODEL=bulbul:v2

# Public base URL of THIS app as providers reach it (A6) — used to build
# the Vapi end-of-call webhook URL and the Plivo answer/status URLs.
# For live calling this must be a publicly reachable HTTPS address
# (e.g. your AWS host or a tunnel); localhost works only for stub mode.
PUBLIC_BASE_URL=http://localhost:8000

# Shared secret for provider webhooks (§8.1). Vapi sends it back as the
# x-vapi-secret header; the webhook route fails closed while this is
# empty. Set a long random value before enabling managed mode.
WEBHOOK_SECRET=

# First-boot seed (demo tenant + login)
SEED_TENANT_NAME=QGBS
SEED_USER_EMAIL=demo@qgbs.example
SEED_USER_PASSWORD=demo-password
